# Copy this file to .env and fill in the values

# Which brain starts by default: claude or ollama (you can also switch in the website menu)
BRAIN=claude

# A: Claude API (get a key from https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# B: Open-source model through Ollama (https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

PORT=3000
